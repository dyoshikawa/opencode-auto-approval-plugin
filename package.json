{
  "name": "opencode-auto-approval-plugin",
  "version": "0.13.3",
  "description": "opencode plugin that auto-approves tool permission requests based on configurable rules",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "permission",
    "auto-approval",
    "typescript"
  ],
  "homepage": "https://github.com/dyoshikawa/opencode-auto-approval-plugin#readme",
  "bugs": {
    "url": "https://github.com/dyoshikawa/opencode-auto-approval-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dyoshikawa/opencode-auto-approval-plugin.git"
  },
  "license": "MIT",
  "author": "dyoshikawa",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "opencode-auto-approval-plugin": "dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vp pack",
    "check": "vp check --deny-warnings && pnpm run typecheck",
    "cicheck": "pnpm run cicheck:code && pnpm run cicheck:content",
    "cicheck:code": "pnpm run check && pnpm run test",
    "cicheck:content": "pnpm run cspell && pnpm run secretlint",
    "cspell": "cspell --no-progress --gitignore .",
    "fix": "vp check --fix",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "generate": "rulesync generate",
    "knip": "knip",
    "oxlint": "vp lint --max-warnings 0",
    "oxlint:fix": "vp lint --fix --max-warnings 0",
    "prepare": "node scripts/install-git-hooks.mjs && pnpm generate",
    "prepublishOnly": "pnpm build",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "sort": "sort-package-json",
    "test": "vp test run --silent=true",
    "test:coverage": "vp test run --coverage --silent=true",
    "test:watch": "vp test --silent=true",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.312",
    "@openai/codex-sdk": "0.165.0",
    "@opencode-ai/plugin": "1.19.4",
    "@opencode/plugin": "2.2.0",
    "@secretlint/secretlint-rule-preset-recommend": "13.1.0",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "cspell": "10.4.0",
    "knip": "6.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "rulesync": "43.2.0",
    "secretlint": "13.1.0",
    "sort-package-json": "4.1.0",
    "typescript": "7.0.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.3.0 <1",
    "@openai/codex-sdk": ">=0.163.0 <1",
    "@opencode-ai/plugin": ">=1.18.29 <2",
    "@opencode/plugin": ">=2.0.0 <3"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@openai/codex-sdk": {
      "optional": true
    },
    "@opencode-ai/plugin": {
      "optional": true
    },
    "@opencode/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "publishConfig": {
    "access": "public"
  }
}
