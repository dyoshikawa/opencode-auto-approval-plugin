{
  "name": "opencode-auto-approval-plugin",
  "version": "0.1.1",
  "description": "opencode plugin that auto-approves tool permission requests based on configurable rules",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "plugin",
    "permission",
    "auto-approval",
    "typescript"
  ],
  "homepage": "https://github.com/dyoshikawa/opencode-auto-approval-plugin#readme",
  "bugs": {
    "url": "https://github.com/dyoshikawa/opencode-auto-approval-plugin/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dyoshikawa/opencode-auto-approval-plugin.git"
  },
  "license": "MIT",
  "author": "dyoshikawa",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "check": "pnpm run fmt:check && pnpm run oxlint && pnpm run typecheck",
    "cicheck": "pnpm run cicheck:code && pnpm run cicheck:content",
    "cicheck:code": "pnpm run check && pnpm run test",
    "cicheck:content": "pnpm run cspell && pnpm run secretlint",
    "cspell": "cspell --no-progress --gitignore .",
    "fix": "pnpm run fmt && pnpm run oxlint:fix",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "generate": "rulesync generate",
    "knip": "knip",
    "oxlint": "oxlint . --max-warnings 0",
    "oxlint:fix": "oxlint . --fix --max-warnings 0",
    "prepare": "simple-git-hooks && pnpm generate",
    "prepublishOnly": "pnpm build",
    "secretlint": "secretlint --secretlintignore .gitignore \"**/*\"",
    "sort": "sort-package-json",
    "test": "vitest run --silent=true",
    "test:coverage": "vitest run --coverage --silent=true",
    "test:watch": "vitest --silent=true",
    "typecheck": "tsc --noEmit"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "dependencies": {
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.25",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.5",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "cspell": "10.1.1",
    "knip": "6.33.0",
    "lint-staged": "17.4.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "rulesync": "16.19.0",
    "secretlint": "13.0.5",
    "simple-git-hooks": "2.14.0",
    "sort-package-json": "4.0.0",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.16 <2"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "publishConfig": {
    "access": "public"
  }
}
